      "IO": {
        "inputs": 1,
        "outputs": 1
      },
      "input_types": [
        "audio"
      ],
      "output_type": "audio",
      "schema_version": 1,
      "fields": [
        {
          "key": "decibels",
          "label": "Gain (dB)",
          "type": "number",
          "default": -6,
          "min": -60,
          "max": 12
        }
      ]
    }
  ],
  "permissions": {
    "files": {
      "read": false,
      "write": false
    },
    "network": []
  },
  "limits": {
    "memory_mb": 16,
    "time_ms": 1000,
    "fuel": 1000000
  },
  "dependencies": []
}
