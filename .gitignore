# ============================================================
# FFmpeg_plus_plus 根级忽略规则
# ============================================================

# Flutter 工具状态缓存（误提交过，禁止再入库）
.config/

# 本地 Flutter SDK 源码副本（约 1.7GB），勿提交入库
.flutter-sdk/

# 通用临时/缓存文件
*.log
*.tmp
.DS_Store

# ---- 编辑器 / 智能体本地状态目录 ----
# 曾误提交 .zcode/plans/ 与 .workbuddy/memory/，故一并拦截
.vscode/
.claude/
.idea/
.zcode/
.workbuddy/

# ---- 打包暂存目录 ----
# 根 build/ 是双重身份：既存放已入库的构建脚本（build_all.sh / build_desktop.sh /
# android/），又是 Inno Setup 与 CI 解压 Flutter bundle 的暂存目录
# （make/setup.iss 的 SourceRoot = ..\build；CI 里 tar -xzf bundle -C build）。
# 整目录忽略会误伤脚本，整目录放行又会让 `git add -A` 把整个 bundle（含
# data/flutter_assets/**）扫进版本库 —— 这里采用「默认忽略 + 显式放行脚本」。
/build/*
!/build/README.md
!/build/build_all.sh
!/build/build_desktop.sh
!/build/android/

# 安装包输出目录（Inno Setup 的 OutputDir）
/dist/

# ---- 编译产物 / 分发目录 ----
# server.dist/ 曾整体入库（server.exe、python311.dll、*.pyd 等，约 23MB）
server.dist/
*.exe
*.dll
*.pyd
*.res
*.obj
*.pdb
*.ilk
*.exp
nuitka-crash-report.xml

# ---- 依赖 / 缓存 ----
__pycache__/
*.pyc
.cache/

# ---- 工具误产出的临时文件（曾误提交 wb_an_a1/a2.txt）----
wb_an_*
