{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FFmpeg++ plugin manifest v1",
  "description": "Host validation is authoritative, including semantic version ranges, origins, unique field IDs and numerical bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "api_version",
    "app_version",
    "Basic_info"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "api_version": {
      "const": 1
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "Basic_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Name",
        "Version",
        "IsPreview",
        "Summary"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "Version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "IsPreview": {
          "type": "boolean"
        },
        "Summary": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:]).+\\.wasm$"
    },
    "Node_info": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 128
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "boolean",
              "default": false
            },
            "write": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^/?#]+$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 16
        },
        "time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 1000
        },
        "fuel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "default": 1000000
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 32
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "theme.schema.json"
      },
      "maxItems": 64
    },
    "ai_configs": {
      "type": "array",
      "items": {
        "$ref": "ai-config.schema.json"
      },
      "maxItems": 64
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "Node_info"
        ],
        "properties": {
          "Node_info": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "module"
        ]
      }
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type",
        "default"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "number",
            "integer",
            "string",
            "boolean",
            "select"
          ]
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fun",
        "IsLogic",
        "IO",
        "input_types",
        "output_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fun": {
          "type": "string",
          "maxLength": 4096
        },
        "IsLogic": {
          "type": "boolean"
        },
        "IO": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputs",
            "outputs"
          ],
          "properties": {
            "inputs": {
              "const": 1
            },
            "outputs": {
              "const": 1
            }
          }
        },
        "input_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "video",
              "audio",
              "image"
            ]
          }
        },
        "output_type": {
          "enum": [
            "video",
            "audio",
            "image"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "maxItems": 64
        }
      }
    }
  }
}
